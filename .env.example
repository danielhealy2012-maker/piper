# ---------------------------------------------------------------------------
# Local development
# ---------------------------------------------------------------------------
# Used by server/proxy.mjs (local API) — never exposed to the browser.
ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Multiplayer (optional locally; required in production)
# ---------------------------------------------------------------------------
# From Supabase → Project Settings → API. The anon key is safe in the browser:
# every table is protected by row level security.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ---------------------------------------------------------------------------
# Production only (set these as Vercel environment variables, NOT in git)
# ---------------------------------------------------------------------------
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   # server-side only — never prefix with VITE_

# ---------------------------------------------------------------------------
# AI-generated backgrounds (production only — api/image.js)
# ---------------------------------------------------------------------------
# From replicate.com → Account → API tokens. Not available in local dev
# (server/proxy.mjs returns a clean 503 for /api/image; the theme model
# falls back to a fixed scene automatically).
# REPLICATE_API_TOKEN=r8_...
